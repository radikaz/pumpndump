{
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "mock:setup": "ts-mocha -p ./tsconfig.json -t 1000000 --exit executor/setup.ts",
    "mock:run": "ts-mocha -p ./tsconfig.json -t 0 executor/run.ts",
    "mock:smoke": "ts-mocha -p ./tsconfig.json -t 0 --exit executor/smoke.ts",
    "mock:bundle": "esbuild executor/main.ts --bundle --platform=node --target=node22 --outfile=dist/executor.js",
    "demo:bundle": "esbuild executor/v2/service.ts --bundle --platform=node --target=node22 --outfile=dist/executor-v2.js && esbuild executor/v2/setup.ts --bundle --platform=node --target=node22 --outfile=dist/setup-v2.js",
    "demo:test": "ts-mocha -p ./tsconfig.json --exit tests/demo_ledger.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.2",
    "@arcium-hq/client": "0.16.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "esbuild": "0.24.2",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
